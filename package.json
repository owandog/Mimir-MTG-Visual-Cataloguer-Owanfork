{
  "name": "mimir",
  "version": "0.1.3-owan.1",
  "description": "Local-first MTG card scanner and catalogue",
  "main": "dist/main/main.js",
  "author": "JovinJovinsson",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --outfile=dist/main/main.js --platform=node --format=cjs --target=node24 --external:electron --external:better-sqlite3 --external:electron-updater",
    "build:worker": "esbuild src/main/bulk-parse-worker.ts --bundle --outfile=dist/main/bulk-parse-worker.js --platform=node --format=cjs --target=node24",
    "build:preload": "esbuild src/main/preload.ts --bundle --outfile=dist/main/preload.js --platform=node --format=cjs --target=node24 --external:electron",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.js --platform=browser --format=iife --target=es2022",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:worker && npm run build:preload && npm run build:renderer && npm run build:assets",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dev": "npm run build && npm run rebuild:electron && electron .",
    "package": "npm run build && npm run rebuild:electron && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "pretest": "npm run rebuild:node",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.jovinjovinsson.mimir",
    "productName": "Mimir",
    "copyright": "Copyright © 2026 JovinJovinsson",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/test_extension.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "owandog",
      "repo": "Mimir-MTG-Visual-Cataloguer-Owanfork"
    },
    "afterSign": "build/afterSign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "JovinJovinsson <yggdragamesstudio@gmail.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": true
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3"
  }
}
